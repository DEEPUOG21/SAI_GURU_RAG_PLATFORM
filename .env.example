# Copy to .env at repository root. scripts/configure_local.py generates local secrets.
POSTGRES_PASSWORD=
RUNTIME_DATABASE_PASSWORD=
# Owner credentials are for migrations only; the API uses sai_runtime.
DATABASE_URL=postgresql+asyncpg://sai:YOUR_URL_ENCODED_PASSWORD@localhost:5432/sai_guru
SQL_READER_PASSWORD=
SQL_DATABASE_URL=postgresql+asyncpg://sai_reader:YOUR_URL_ENCODED_READER_PASSWORD@localhost:5432/sai_guru
JWT_SECRET=
SEED_ADMIN_EMAIL=admin@saitech.example
SEED_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
PORT=8000
# Local ONNX models. Install backend[local]. Dimensions must match the migrated schema.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
RERANKER_PROVIDER=local
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Optional HTTP model service; see docs/guides/DEPLOYMENT.md.
# Free hosted option: docs/guides/FREE-INFERENCE.md (reranker provider: cloudflare).
EMBEDDING_URL=
RERANKER_URL=
INFERENCE_API_KEY=
# Ollama or another compatible LLM endpoint. API keys stay on the backend.
LLM_URL=http://localhost:11434/v1
LLM_PROVIDER=openai
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
GENERATION_MODE=llm
GROUNDING_ACTION=regenerate
GENERAL_FALLBACK_ENABLED=true
QUERY_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=30
# Optional worker is explicitly tenant-scoped; UI Process works without it.
WORKER_TENANT_ID=
# USD per million tokens. Zero is correct only for local/free inference.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
# Optional hosted observability. Disabled until you configure your own LangSmith account.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sai-guru
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set false only when you intend to send questions, evidence and answers to LangSmith.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
